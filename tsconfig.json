{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@ppwcode/api-contracts/money": ["./src/money/index.ts"],
      "@ppwcode/api-contracts/be": ["./src/be/index.ts"],
      "@ppwcode/api-contracts/string": ["./src/string/index.ts"],
      "@ppwcode/api-contracts/time": ["./src/time/index.ts"]
    }
  },
  "include": ["src", "tests", "*.ts"]
}
