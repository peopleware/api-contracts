      "History": {
        "additionalProperties": {},
        "description": "A list of the different times at which the person's information was changed, ordered from most to least
recent, with links to retrieve that version of the personal information. Changes \`< x-date\` are included.


This call does not use paging, because we expect less than 50 changes to the personal information of a person
over the person's lifetime.",
        "examples": [
          {
            "structureVersion": 1,
            "versions": [
              {
                "createdAt": "2022-08-04T18:48:44.003Z",
                "href": ".?at=2022-08-04T18:48:44.003Z",
              },
              {
                "createdAt": "2020-01-23T15:22:39.212Z",
                "href": ".?at=2020-01-23T15:22:39.212Z",
              },
            ],
          },
        ],
        "properties": {
          "structureVersion": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer",
          },
          "versions": {
            "items": {
              "additionalProperties": {},
              "properties": {
                "createdAt": {
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])-((0[1-9]|[1-2]\\d)|30|31)T(0\\d|1\\d|2[0-3]):([0-5]\\d):([0-5]\\d)\\.\\d{3,}Z$",
                  "type": "string",
                },
                "href": {
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "createdAt",
                "href",
              ],
              "type": "object",
            },
            "type": "array",
          },
        },
        "required": [
          "structureVersion",
          "versions",
        ],
        "type": "object",
      },
      "HistoryVersion": {
        "additionalProperties": {},
        "examples": [
          {
            "createdAt": "2022-08-04T18:48:44.003Z",
            "href": ".?at=2022-08-04T18:48:44.003Z",
