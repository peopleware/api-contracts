                    "NegativeMonetaryValue",
                    "NonNegativeMonetaryValue",
                    "NonPositiveMonetaryValue",
                    "PositiveMonetaryValue",
                    "Decimal",
                    "CanonicalURI",
                    "CanonicalURIWithKnowledgeTime",
                    "CleanedString",
                    "EmailAddress",
                    "Language",
                    "RelativeURI",
                    "TelephoneNumber",
                    "TrimmedString",
                    "DateOnly",
                    "DateTime",
                    "DateOnlyPeriod",
                    "Month",
                    "Quarter",
                    "Year",
                    "ISODateToSecond",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Example",
          },
        },
      },
    },
  },
}
`;

